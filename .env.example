# ============ KnowSuite 配置示例（复制为 .env 后填写） ============

# --- RAGFlow 对接 ---
RAGFLOW_API_BASE=http://127.0.0.1:80        # RAGFlow Web/API 地址
RAGFLOW_API_KEY=ragflow-xxxxxxxxxxxx         # RAGFlow 右上角头像 -> API 页面生成
RAGFLOW_WEB=http://127.0.0.1:80              # OEM 门户反向代理的 RAGFlow 前端地址
# 留空 RAGFLOW_API_KEY 或设 MOCK_RAGFLOW=1 => 全部走 mock 降级（无 RAGFlow 也能开发演示）
MOCK_RAGFLOW=0

# --- 大模型（百炼 OpenAI 兼容，与师生科研工作台同一 Key 可复用） ---
AI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=sk-xxxxxxxxxxxxxxxx
AI_MODEL=qwen-plus                # 问答/评审 judge
AI_EMBED_MODEL=text-embedding-v4  # 旧稿识别用向量
MOCK_LLM=0                        # 1=不调真实模型，返回固定结果（本地冒烟测试用）

# --- ASR（视频转写，三选一，按可用性自动降级到 mock） ---
# A: OpenAI 兼容 /audio/transcriptions（Groq whisper / SiliconFlow FunAudioLLM 等）
ASR_API_BASE=
ASR_API_KEY=
ASR_MODEL=whisper-large-v3-turbo
# B: 百炼 qwen-omni 系（chat completions 传 base64 音频）
ASR_OMNI_MODEL=

# --- 视觉模型（视频关键帧描述） ---
VL_MODEL=qwen-vl-plus

# --- 服务 ---
KNOWSUITE_PORT=8100
DATA_DIR=./data
# 支付网关: mock | qrcode(扫码+人工确认) | alipay(占位)
PAYMENT_GATEWAY=mock
ADMIN_TOKEN=change-me-admin-token   # 管理端接口口令（订单确认/品牌管理/配额调整）
